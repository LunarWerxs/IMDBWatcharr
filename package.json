{
  "name": "imdbwatch",
  "version": "1.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\" && npm --workspace web run lint",
    "dev": "wrangler dev --remote",
    "web:dev": "npm run dev --workspace web",
    "web:build": "npm run build --workspace web",
    "build": "npm run web:build",
    "deploy": "npm run web:build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply imdbwatcharr-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply imdbwatcharr-db --remote",
    "og": "node scripts/make-og.mjs",
    "setup:dispatch": "node scripts/setup-dispatch-token.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "wrangler": "^4.133.0"
  }
}
